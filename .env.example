# Server-only settings. Copy to .env.local for development.
# Generate a random password (at least 24 characters) with a password manager.
ADMIN_PASSWORD=
# Fine-grained GitHub token: this repository only; Contents: Read and write.
ADMIN_GITHUB_TOKEN=
ADMIN_GITHUB_REPOSITORY=nidalasw/www-claimsafe
# Must match the Vercel production branch.
ADMIN_GITHUB_BRANCH=main
